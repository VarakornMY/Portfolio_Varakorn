{
  "name": "varakorn-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Varakorn portfolio with an XP desktop and a handheld interface.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "comments": "node scripts/comments-db.mjs",
    "check:mobile": "node scripts/check-retro.mjs",
    "check:seo": "node scripts/check-prerender.mjs",
    "shots": "node scripts/check-retro.mjs",
    "check:account": "node scripts/check-account.mjs",
    "check:signin": "node scripts/check-signin-ui.mjs",
    "check:profile": "node scripts/check-profile.mjs",
    "dev:cloudflare": "npm run build && wrangler dev --remote",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "check:cloudflare": "node --test scripts/check-cloudflare.test.mjs",
    "check:retro": "node scripts/check-retro.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "postgres": "^3.4.9",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "vite": "^6.0.7",
    "wrangler": "4.151.2"
  }
}
