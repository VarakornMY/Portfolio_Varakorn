# Copy to .env. Never commit .env. Both public values are also needed at build time.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server only: Supabase Auth account deletion.
SUPABASE_SECRET_KEY=

# Supabase transaction pooler (port 6543): Vite dev and the moderation CLI.
# Production Workers use the HYPERDRIVE binding instead.
DATABASE_URL=

# Supabase direct connection (port 5432): migrations and Hyperdrive origin setup.
SUPABASE_DB_DIRECT_URL=

# Server only: the signed in home page chat.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional comma separated Supabase user IDs. Defaults to the existing owner.
ADMIN_USER_IDS=
